# AQC Animal Health — admin web workbench
# Copy to .env.local and adjust. All variables are optional.

# Demo clock anchor. The seed data matches the design reference moment
# (Wed 21 Oct 2026, 08:42, AM session). Use "real" to follow the browser clock
# (seed records are then re-anchored to today).
NEXT_PUBLIC_DEMO_NOW=2026-10-21T08:42:00

# Simulated latency of the in-browser mock API, in milliseconds.
NEXT_PUBLIC_MOCK_LATENCY_MS=280

# Label shown in the sidebar footer.
NEXT_PUBLIC_ENV_LABEL="UAT · POC build 1.0.0"

# Base URL of the real NestJS API (BE-001). Leave empty to use the mock
# service layer in src/services (data persisted in localStorage).
NEXT_PUBLIC_API_BASE_URL=
