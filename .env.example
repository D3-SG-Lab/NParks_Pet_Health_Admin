# AQC Animal Health — admin web workbench
# Copy to .env.local and adjust. All variables are optional.

# Demo clock anchor. The seed data matches the design reference moment
# (Wed 21 Oct 2026, 08:42, AM session). Use "real" to follow the browser clock
# (seed records are then re-anchored to today).
NEXT_PUBLIC_DEMO_NOW=2026-10-21T08:42:00

# Simulated latency of the in-browser mock API, in milliseconds.
NEXT_PUBLIC_MOCK_LATENCY_MS=280

# Label shown in the sidebar footer.
NEXT_PUBLIC_ENV_LABEL="UAT · POC build 1.0.0"

# Origin of the NParksPetHealth API (docs/NParksPetHealth_API.postman_collection.json),
# without /api/v1. Use https:// — the http:// URL redirects and breaks the proxy.
# The browser calls the same-origin /backend path, which Next.js forwards here
# (the API sends no CORS headers). Set at build time; restart/rebuild after changes.
# Leave empty to run fully on the in-browser demo data (src/services mock layer).
NEXT_PUBLIC_API_BASE_URL=https://linthitd3-001-site1.ktempurl.com

# Shows the "Development sign-in" panel (POST /auth/dev-token) on the login page.
# Only works while the API runs in its Development environment.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# OIDC provider used by each login button (the API knows "singpass" and "corppass").
# The redirect URI <app origin>/auth/callback must be registered with the identity provider.
NEXT_PUBLIC_OIDC_PROVIDER_OFFICER=singpass
NEXT_PUBLIC_OIDC_PROVIDER_CONTRACTOR=corppass
